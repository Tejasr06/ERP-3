# ── Server ────────────────────────────────
PORT=3000

# ── MongoDB ───────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/educonnect

# ── Auth ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key

# ── Email (Brevo API) ──────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@yourdomain.com

# Optional SMTP fallback (not used by default)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your_brevo_smtp_username
# BREVO_SMTP_KEY=your_brevo_smtp_password

# ── School Info ───────────────────────────
SCHOOL_NAME=Sri Sairam International School
SCHOOL_ADDRESS=123, Sairam Nagar, Bangalore, Karnataka
SCHOOL_PHONE=+91-9916783757

# ── Razorpay ──────────────────────────────
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Frontend URL ──────────────────────────
FRONTEND_URL=http://localhost:3000
